# CivicPulse Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/civicpulse?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://demoUser:demoPass@cluster0.mongodb.net/civicpulse?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=civicpulse_jwt_super_secret_hackathon_key_2026

# Optional: Cloudinary Evidence Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: AI/Vision API for Multimodal Classification
AI_API_KEY=
AI_API_ENDPOINT=
